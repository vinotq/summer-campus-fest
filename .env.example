NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATA_DIR=./data
DB_FILE=./data/db.sqlite
UPLOADS_DIR=./data/uploads
UPLOAD_MAX_BYTES=5242880

ADMIN_LOGIN=admin
# Генерируется: node server/scripts/hash-password.js 'мой_пароль'
# Формат scrypt:salt:key (двоеточие, не $, чтобы docker-compose не ломал значение)
ADMIN_PASSWORD_HASH=scrypt:REPLACE_ME

# Минимум 32 символа
COOKIE_SECRET=replace-me-with-a-long-random-string-32chars
